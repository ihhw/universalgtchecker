# Replit
.cache/
.local/

# Xbox auth — contains live refresh tokens; persisted automatically at runtime
.xbox-auth.json

# Runtime-generated files from the API server
artifacts/api-server/results.txt
artifacts/api-server/state.json
artifacts/api-server/discord-results.txt
artifacts/api-server/discord-state.json
artifacts/api-server/discord-proxies.json
artifacts/api-server/xbox-proxies.json
artifacts/api-server/probe-debug.log
artifacts/api-server/checker-debug.log
# Same files, ignored again bare: packaging/windows/start.cmd (and the
# systemd unit in packaging/linux-app) run the built server with the repo
# root as its cwd, not artifacts/api-server, so these can land at the root.
discord-results.txt
discord-state.json
discord-proxies.json
xbox-proxies.json
results.txt
state.json
stats.json
webhook.json
probe-debug.log
checker-debug.log
artifacts/discord-bot/search_state.json

artifacts/api-server/webhook.json

# Xbox Sniper persisted state (runtime)
artifacts/api-server/sniper.json
sniper.json

# Analytics counters persisted state (runtime)
artifacts/api-server/stats.json
stats.json

# Persistent "recently confirmed taken" cache (runtime)
artifacts/api-server/checked-cache.json
checked-cache.json

# Python
__pycache__/
*.pyc
.pytest_cache/
